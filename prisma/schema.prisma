// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HeightUnit {
  CM
  INCH
}

enum WeightUnit {
  KG
  LB
}

enum Sex {
  MALE
  FEMALE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum DeficitLevel {
  LOW
  MEDIUM
  EXTREME
}

enum DietPreference {
  VEG
  NON_VEG
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

model User {
  id             Int            @id @default(autoincrement())
  name           String
  height         Float
  heightUnit     HeightUnit
  weight         Float
  weightUnit     WeightUnit
  targetWeight   Float?
  sex            Sex
  birthYear      Int
  goal           Goal
  deficitLevel   DeficitLevel
  dietPreference DietPreference
  activityLevel  ActivityLevel
  meals          Meal[]
  activities     Activity[]
  summaries      DailySummary[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Meal {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  mealType    MealType
  name        String
  image       String?  // Image path or URL
  quantity    Float
  unit        String
  healthScore Int
  calories    Int      @default(0)
  protein     Float    @default(0)
  carbs       Float    @default(0)
  fats        Float    @default(0)
  fiber       Float    @default(0)
  ingredients String?  // Can be a string list or description
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailySummary {
  id               Int      @id @default(autoincrement())
  date             DateTime @default(now())
  totalCalories    Int
  totalProtein     Float
  totalCarbs       Float
  totalFats        Float
  totalFiber       Float
  totalHealthScore Int
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, userId])
}

enum ActivityType {
  WALKING
  RUNNING
  CYCLING
  SWIMMING
  YOGA
  STRENGTH_TRAINING
}

model Activity {
  id        Int          @id @default(autoincrement())
  date      DateTime     @default(now())
  type      ActivityType
  duration  Int?         // in minutes
  user      User         @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
